# Copy this file to `.env.local` and replace placeholders with rotated keys.
# `.env.local` is ignored by Git. Never commit or paste real keys into code.
# Export these variables before launching; Python does not auto-load this file.
HIVE_API_KEY=replace-with-rotated-hive-key
SIGHTENGINE_API_USER=replace-with-sightengine-user
SIGHTENGINE_API_SECRET=replace-with-rotated-sightengine-secret
DEEPSEEK_API_KEY=replace-with-rotated-deepseek-key

CLOSEAI_API_KEY=replace-with-rotated-closeai-key
CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1

ZZZ_API_KEY=replace-with-zhizengzeng-key
ZZZ_BASE_URL=https://api.zhizengzeng.com/v1

